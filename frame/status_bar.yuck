(include "layout/status.yuck")

(defwindow briskbar_m0
	:exclusive true
	:focusable false
	:geometry (
		geometry
			:anchor "top center"
			:height "1.5%" 
			:width "100%"
	)
	:monitor 0 ;; for Wayland
	:stacking "fg"
	(briskbar)
)

